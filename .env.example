# Supabase > Project Settings > API: öffentliche Projektkonfiguration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Alternativ wird NEXT_PUBLIC_SUPABASE_ANON_KEY unterstützt.
# Feedback-Fenster beim Launch scharfschalten ("true" speichert live in Supabase; ohne "true" läuft der Vorschau-Modus):
NEXT_PUBLIC_FEEDBACK_ENABLED=false
# Keine Service-Role-Schlüssel oder OCR-Schlüssel in NEXT_PUBLIC_-Variablen!
